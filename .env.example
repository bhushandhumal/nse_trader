# Copy to .env.dev / .env.uat / .env.prod and fill in real values.
# Run with: python main.py --env dev|uat|prod
# Access token is valid ~30 days — regenerate from https://api.dhan.co

DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Optional overrides (defaults are set in main.py)
CAPITAL=3000
TICKERS=GODREJCP,DABUR,ICICIPRULI,NAUKRI,HAVELLS,INDHOTEL
