# Copy to .env and fill in real values.
# Run with: python main.py [--dry-run]

DHAN_CLIENT_ID=your_dhan_client_id

# DHAN_TOTP_SECRET: the base32 secret from your Dhan 2FA / Google Authenticator QR code.
#   In the Dhan app: Security -> 2FA -> show QR code.
#   The base32 secret is the `secret=` parameter in the otpauth:// URL.
# DHAN_PIN: your 4-6 digit Dhan login PIN.
DHAN_TOTP_SECRET=BASE32SECRETHERE
DHAN_PIN=your_dhan_pin

CAPITAL=1000000
TICKERS=RELIANCE,INFY
